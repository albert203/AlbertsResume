<!DOCTYPE html>
<html lang="en">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Albert Jordaan - Contact Me</title>
    <link rel="stylesheet" href="../css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
    /* ── Contact Page ────────────────────── */
    .contact_page { min-height: calc(100vh - var(--header_height)); display: flex; align-items: center; padding: 2rem 0; }
    .contact_inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; }

    /* Left: info */
    .contact_info_sub { font-size: 0.95rem; color: var(--text_color); line-height: 1.7; margin-bottom: 2.5rem; }
    .contact_details { display: flex; flex-direction: column; gap: 1.25rem; }
    .contact_detail { display: flex; flex-direction: column; gap: 0.2rem; }
    .contact_detail_label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text_color); }
    .contact_detail_value { font-size: 0.95rem; color: var(--text_color); text-decoration: none; font-weight: 500; transition: color 0.2s ease; }
    .contact_detail_value:hover { color: var(--primary_color); }
    .contact_socials { display: flex; gap: 1rem; margin-top: 2rem; }
    .contact_social { font-size: 0.85rem; font-weight: 500; color: var(--text_color); text-decoration: none; padding: 0.5rem 1rem; border: 1.5px solid #e8e8e4; border-radius: 8px; transition: all 0.2s ease; }
    .contact_social:hover { border-color: var(--primary_color); color: var(--primary_color); }

    /* Right: form */
    .contact_form { display: flex; flex-direction: column; gap: 1.25rem; }
    .form_group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form_label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text_color); }
    .form_input { padding: 0.75rem 1rem; border: 1.5px solid #e8e8e4; border-radius: 8px; font-size: 0.9rem; font-family: inherit; color: var(--text_color); background: #fff; transition: border-color 0.2s ease; outline: none; }
    .form_input:focus { border-color: var(--primary_color); box-shadow: 0 0 0 3px rgba(0,82,255,0.08); }
    .form_textarea { resize: vertical; min-height: 140px; }
    .form_submit { align-self: flex-start; }
    .form_success { display: none; padding: 1rem; background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.3); border-radius: 8px; color: #16a34a; font-size: 0.88rem; }
  </style>
</head>
<body>

  <%- include('partials/header') %>

  <main>
    <section class="contact_page">
      <div class="contact_inner">

        <!-- Left: contact info -->
        <div class="contact_info">
          <span class="section_label">Contact Me</span>
          <h1 class="section_title">Let's build something <em>together.</em></h1>

          <div class="contact_details">
            <div class="contact_detail">
              <span class="contact_detail_label">Email</span>
              <a href="mailto:albert.jordaan@outlook.com" class="contact_detail_value">albert.jordaan@outlook.com <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.75em;"></i></a>
            </div>
            <div class="contact_detail">
              <span class="contact_detail_label">Phone</span>
              <a href="tel:+61415377409" class="contact_detail_value">+61 415 377 409</a>
            </div>
            <div class="contact_detail">
              <span class="contact_detail_label">Location</span>
              <span class="contact_detail_value">Victoria, Australia</span>
            </div>
          </div>

          <div class="contact_socials">
            <a href="https://www.linkedin.com/in/albert-jordaan/" target="_blank" class="contact_social">LinkedIn <i class="fa-brands fa-linkedin"></i></a>
            <a href="https://github.com/albert203/" target="_blank" class="contact_social">GitHub <i class="fa-brands fa-github"></i></a>
          </div>
        </div>

        <!-- Right: form -->
        <form class="contact_form" id="contact_form" method="post" action="/contact">
          <div class="form_group">
            <label class="form_label" for="name">Your name</label>
            <input class="form_input" type="text" id="name" name="name" placeholder="John Smith" required />
          </div>
          <div class="form_group">
            <label class="form_label" for="email">Email address</label>
            <input class="form_input" type="email" id="email" name="email" placeholder="john@company.com" required />
          </div>
          <div class="form_group">
            <label class="form_label" for="subject">Subject</label>
            <input class="form_input" type="text" id="subject" name="subject" placeholder="Job opportunity / Project enquiry" />
          </div>
          <div class="form_group">
            <label class="form_label" for="message">Message</label>
            <textarea class="form_input form_textarea" id="message" name="message" placeholder="Tell me about the role or project..." required></textarea>
          </div>
          <div class="form_success" id="form_success">
            Message Successfully sent, I'll get back to you very soon!
          </div>
          <button type="submit" class="btn btn_primary form_submit">Send message</button>
        </form>

      </div>
    </section>
  </main>

  <script src="/js/script.js"></script>
    
    
</body>
</html>