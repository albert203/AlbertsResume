<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="../css/styles.css" />

    <style>
      /* ── Hero ────────────────────────────── */
      .hero { min-height: calc(100vh - var(--header_height)); display: flex; align-items: center; }
      .hero_inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      .hero_tag { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 500; color: var(--primary_color); background: rgba(0,82,255,0.07); padding: 0.5rem 0.85rem; border-radius: 8px; margin-bottom: 1.5rem; }
      .hero_tag::before { content: ''; width: 8px; height: 8px; background: #22c55e; border-radius: 50%; animation: pulse 2s infinite; }
      .hero_title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; color: var(--text_color); margin-bottom: 1.5rem; }
      .hero_name { color: var(--primary_color); }
      .hero_sub { font-size: 1.05rem; color: #6b6b6b; line-height: 1.7; max-width: 480px; margin-bottom: 2.5rem; }
      .hero_actions { display: flex; gap: 1rem; }
      .hero_visual { position: relative; display: flex; align-items: center; justify-content: center; height: 380px; }
      .hero_blob { position: absolute; width: 320px; height: 320px; border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; animation: morph 10s ease-in-out infinite; }
      .hero_blob::before { content: ''; position: absolute; inset: -4px; background: linear-gradient(45deg, #ff0000, #ff7300, #fffb00, #48ff00, #00ffd5, #002bff, #7a00ff, #ff00c8, #ff0000); background-size: 400%; border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; z-index: -1; animation: morph 8s ease-in-out infinite, rainbow 20s linear infinite; }

      /* ── Animations ──────────────────────── */
      @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(0.9); } 50% { opacity: 0.5; transform: scale(0.8); } }
      @keyframes morph { 0% { border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; } 33% { border-radius: 45% 55% 35% 65% / 60% 40% 65% 35%; } 66% { border-radius: 35% 65% 60% 40% / 45% 55% 40% 60%; } 100% { border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; } }
      @keyframes rainbow { 0% { background-position: 0 0; } 50% { background-position: 100% 0; } 100% { background-position: 0 0; } }
      @keyframes float { 0%, 100% { transform: translateY(0px) rotate(0deg); } 33% { transform: translateY(-6px) rotate(-1.5deg); } 66% { transform: translateY(-3px) rotate(1deg); } }

      /* ── About ───────────────────────────── */
      .about { padding: 3rem 0; background: #f9f9f7; border-top: 1px solid #e8e8e4; }
      .about_inner {gap: 4rem; max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      .about_grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; }
      .about_body { font-size: 1.05rem; color: #6b6b6b; line-height: 1.7; margin-bottom: 2rem; }
      .about_list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }
      .about_list li { font-size: 0.88rem; color: #6b6b6b;  padding: 0.5rem 1rem; line-height: 1.4; border-left: 2px solid var(--primary_color); display: flex; flex-direction: column; gap: 0.1rem; }
      .about_list_title { font-size: 0.82rem; font-weight: 600; color: var(--text_color); text-transform: uppercase; letter-spacing: 0.05em; }
      .about_stats { display: flex; flex-direction: column; gap: 2.5rem; align-items: center; justify-content: center; padding: 2.5rem; background: #0052ff08; border: 1px solid #e8e8e4; border-radius: 16px; }
      .stat { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; text-align: center; }
      .stat_num { display: inline-block; position: relative; font-size: 2.5rem; color: var(--primary_color); line-height: 1; animation: float 3s ease-in-out infinite; }
      .stat:nth-child(2) .stat_num { animation-duration: 3.5s; animation-delay: 0.3s; }
      .stat:nth-child(3) .stat_num { animation-duration: 4s; animation-delay: 0.6s; }
      .stat_label { font-size: 0.78rem; color: #6b6b6b; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500; }

      /* ── Scroll Trail ────────────────────── */
      .scroll_trail { position: fixed; right: 2rem; top: 50%; transform: translateY(-50%); z-index: 50; display: flex; flex-direction: column; align-items: center; }
      .scroll_trail_bar { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 2px; height: 100%; background: #e8e8e4; border-radius: 2px; z-index: 0; }
      .scroll_dots { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 2rem; }
      .scroll_dot { position: relative; width: 10px; height: 10px; border-radius: 50%; background: #e8e8e4; border: 2px solid #e8e8e4; cursor: pointer; transition: all 0.3s ease; }
      .scroll_dot.active { background: var(--primary_color); border-color: var(--primary_color); transform: scale(1.3); }
      .scroll_dot:hover { border-color: var(--primary_color); }
      .scroll_dot_label { position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 0.7rem; font-weight: 500; color: var(--text_color); white-space: nowrap; opacity: 0; transition: opacity 0.2s ease; letter-spacing: 0.05em; text-transform: uppercase; }
      .scroll_dot:hover .scroll_dot_label { opacity: 1; }
      .scroll_dot.active .scroll_dot_label { opacity: 1; color: var(--primary_color); }
    </style>
  </head>

  <body>

    <%- include('partials/header') %>

    <!-- Scroll progress trail -->
    <div class="scroll_trail">
      <div class="scroll_trail_bar"></div>
      <div class="scroll_dots">
        <div class="scroll_dot active" data-section="hero">
          <span class="scroll_dot_label">Home</span>
        </div>
        <div class="scroll_dot" data-section="about">
          <span class="scroll_dot_label">About</span>
        </div>
        <div class="scroll_dot" data-section="experience">
          <span class="scroll_dot_label">Experience</span>
        </div>
        <div class="scroll_dot" data-section="projects">
          <span class="scroll_dot_label">Projects</span>
        </div>
      </div>
    </div>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero_inner">

          <!-- Left: text content -->
          <div class="hero_content">
            <span class="hero_tag">Available for work</span>
            <h1 class="hero_title">Hi, I'm <span class="hero_name">Albert</span> —<br/>Full Stack Developer</h1>
            <p class="hero_sub">
              I build clean, performant web applications from database to deployment.
              Focused on thoughtful code and great user experiences.
            </p>
            <div class="hero_actions">
              <a href="/projects" class="btn btn_primary">View My Work</a>
              <a href="/contact" class="btn btn_ghost">Get in touch</a>
            </div>
          </div>

          <!-- Right: visual -->
          <div class="hero_visual">
            <div class="hero_blob"></div>
          </div>
        </div>
      </section>

    <!-- ABOUT -->
    <section class="about">
      <div class="about_inner">

        <div class="about_text">
          <span class="section_label">About me</span>
          <h2 class="section_title">Turning ideas into <em>reality</em></h2>

          <p class="about_body">
            Full stack engineer with 2+ years turning complex problems into
            clean, scalable solutions. 
          </p>

          <div class="about_grid">
            <ul class="about_list">
              <li>
                <span class="about_list_title">API Integrations</span>
                Connected third-party services into production systems
              </li>
              <li>
                <span class="about_list_title">File Storage</span>
                Configured profile image storage for thousands of users using Cloudflare Images API
              </li>
              <li>
                <span class="about_list_title">Performance</span>
                Optimised existing queries to deliver 10x faster load times
              </li>
              <li>
                <span class="about_list_title">Dashboards</span>
                Built interactive analytics with real-time data
              </li>
              <li>
                <span class="about_list_title">UI & UX</span>
                Improved interfaces that measurably lifted engagement & userflow
              </li>
            </ul>

            <!-- Right: stats -->
            <div class="about_stats">
              <div class="stat">
                <span class="stat_num">2+</span>
                <span class="stat_label">Years experience</span>
              </div>
              <div class="stat">
                <span class="stat_num">25+</span>
                <span class="stat_label">Projects shipped</span>
              </div>
              <div class="stat">
                <span class="stat_num">∞</span>
                <span class="stat_label">Things to learn</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    </main>
    <script src="../js/script.js"></script>
  </body>
</html>