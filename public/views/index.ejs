<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Albert Jordaan - Portfolio</title>
    <link rel="stylesheet" href="../css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
      html{scroll-behavior: smooth;}

      /* ── Hero ────────────────────────────── */
      .hero { min-height: calc(100vh - var(--header_height)); display: flex; align-items: center; }
      .hero_inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      .hero_tag { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 500; color: var(--primary_color); background: rgba(0,82,255,0.07); padding: 0.5rem 0.85rem; border-radius: 8px; margin-bottom: 1.5rem; }
      .hero_tag::before { content: ''; width: 8px; height: 8px; background: #22c55e; border-radius: 50%; animation: pulse 2s infinite; }
      .hero_title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; color: var(--text_color); margin-bottom: 1.5rem; }
      .hero_name { color: var(--primary_color); }
      .hero_sub { font-size: 1.05rem; color: #6b6b6b; line-height: 1.7; max-width: 480px; margin-bottom: 2.5rem; }
      .hero_actions { display: flex; gap: 1rem; }
      .hero_visual { position: relative; display: flex; align-items: center; justify-content: center; height: 380px; }
      .hero_blob { position: absolute; width: 320px; height: 320px; border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; animation: morph 10s ease-in-out infinite; }
      .hero_blob::before { content: ''; position: absolute; inset: -4px; background: linear-gradient(45deg, #ff0000, #ff7300, #fffb00, #48ff00, #00ffd5, #002bff, #7a00ff, #ff00c8, #ff0000); background-size: 400%; border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; z-index: -1; animation: morph 8s ease-in-out infinite, rainbow 20s linear infinite; }

      /* ── Animations ──────────────────────── */
      @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(0.9); } 50% { opacity: 0.5; transform: scale(0.8); } }
      @keyframes morph { 0% { border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; } 33% { border-radius: 45% 55% 35% 65% / 60% 40% 65% 35%; } 66% { border-radius: 35% 65% 60% 40% / 45% 55% 40% 60%; } 100% { border-radius: 65% 35% 55% 45% / 50% 65% 35% 50%; } }
      @keyframes rainbow { 0% { background-position: 0 0; } 50% { background-position: 100% 0; } 100% { background-position: 0 0; } }
      @keyframes float { 0%, 100% { transform: translateY(0px) rotate(0deg); } 33% { transform: translateY(-6px) rotate(-1.5deg); } 66% { transform: translateY(-3px) rotate(1deg); } }

      /* ── About ───────────────────────────── */
      .about { padding: 3rem 0; background: #f9f9f7; border-top: 1px solid #e8e8e4; }
      .about_inner {gap: 4rem; max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      .about_grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; }
      .about_body { font-size: 1.05rem; color: #6b6b6b; line-height: 1.7; margin-bottom: 2rem; }
      .about_list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }
      .about_list li { font-size: 0.88rem; color: #6b6b6b;  padding: 0.5rem 1rem; line-height: 1.4; border-left: 2px solid var(--primary_color); display: flex; flex-direction: column; gap: 0.1rem; }
      .about_list_title { font-size: 0.82rem; font-weight: 600; color: var(--text_color); text-transform: uppercase; letter-spacing: 0.05em; }
      .about_stats { display: flex; flex-direction: column; gap: 2.5rem; align-items: center; justify-content: center; padding: 2.5rem; background: #0052ff08; border: 1px solid #e8e8e4; border-radius: 16px; }
      .stat { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; text-align: center; }
      .stat_num { display: inline-block; position: relative; font-size: 2.5rem; color: var(--primary_color); line-height: 1; animation: float 3s ease-in-out infinite; }
      .stat:nth-child(2) .stat_num { animation-duration: 3.5s; animation-delay: 0.3s; }
      .stat:nth-child(3) .stat_num { animation-duration: 4s; animation-delay: 0.6s; }
      .stat_label { font-size: 0.78rem; color: #6b6b6b; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500; }

      /* ── Scroll Trail ────────────────────── */
      .scroll_trail { position: fixed; right: 2rem; top: 50%; transform: translateY(-50%); z-index: 50; display: flex; flex-direction: column; align-items: center; }
      .scroll_trail_bar { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 2px; height: 100%; background: #e8e8e4; border-radius: 2px; z-index: 0; }
      .scroll_dots { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 2rem; }
      .scroll_dot { position: relative; width: 10px; height: 10px; border-radius: 50%; background: #e8e8e4; border: 2px solid #e8e8e4; cursor: pointer; transition: all 0.3s ease; }
      .scroll_dot.active { background: var(--primary_color); border-color: var(--primary_color); transform: scale(1.3); }
      .scroll_dot:hover { border-color: var(--primary_color); }
      .scroll_dot_label { position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 0.7rem; font-weight: 500; color: var(--text_color); white-space: nowrap; opacity: 0; transition: opacity 0.2s ease; letter-spacing: 0.05em; text-transform: uppercase; }
      .scroll_dot:hover .scroll_dot_label { opacity: 1; }
      .scroll_dot.active .scroll_dot_label { opacity: 1; color: var(--primary_color); }
      section { scroll-margin-top: 65px; }

      /* ── Experience ──────────────────────── */
      .experience { padding: 4rem 0; border-top: 1px solid #e8e8e4; }
      .experience_inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      .timeline { margin-top: 2rem; }
      .timeline_item { display: grid; grid-template-columns: 160px 1fr; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid #e8e8e4; }
      .timeline_item:last-child { border-bottom: none; }
      .timeline_meta { display: flex; align-items: flex-start; gap: 0.5rem; padding-top: 0.2rem; }

      /* ── Work Experience ──────────────────────── */
      .experience { padding: 4rem 0; border-top: 1px solid #e8e8e4; }
      .experience_inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: grid; grid-template-columns: 80px 1fr; gap: 0 2rem; }
      .experience_header { grid-column: 1 / -1; margin-bottom: 1rem; }

      /* Left column: the continuous dashed line + dots */
      .timeline_spine { display: flex; flex-direction: column; align-items: center; padding-top: 0.4rem; }
      .timeline_spine_dot { width: 10px; height: 10px; background: var(--primary_color); border-radius: 50%; flex-shrink: 0; }
      .timeline_spine_label { font-size: 0.72rem; color: #6b6b6b; white-space: nowrap; margin-bottom: 0.4rem; }
      .timeline_spine_trail { flex: 1; border-left: 2px dashed #d0d0d0; }

      /* Right column: cards */
      .timeline_card { border: 1px solid #6b6b6b; border-radius: 12px; padding: 1.5rem 2rem; margin-bottom: 1.5rem; transition: transform 0.2s ease; }
      .timeline_card:hover { box-shadow: 0 4px 20px rgba(0,82,255,0.08); transform: translateY(-2px); }
      .timeline_card_date { font-size: 0.78rem; color: #6b6b6b; margin-bottom: 0.5rem; }
      .timeline_role { font-size: 1.15rem; font-weight: 600; color: var(--text_color); margin-bottom: 0.15rem; }
      .timeline_company { display: inline-flex; align-items: center; gap: 0.4em; font-size: 0.88rem; text-decoration: none; color: var(--primary_color); font-weight: 500; margin-bottom: 1rem; cursor: pointer; }
      .timeline_list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; }
      .timeline_list li { font-size: 0.88rem; color: #6b6b6b; padding-left: 1.25rem; position: relative; line-height: 1.5; }
      .timeline_list li::before { content: '—'; position: absolute; left: 0; color: var(--primary_color); font-weight: 700; }
      .timeline_tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .timeline_tags span { font-size: 0.72rem; padding: 0.25rem 0.75rem; background: rgba(0,82,255,0.07); color: var(--primary_color); border-radius: 100px; font-weight: 500; }
    
      /* ── Projects ────────────────────────── */
      .projects { padding: 4rem 0; border-top: 1px solid #e8e8e4; background: #f9f9f7; }
      .projects_inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      .projects_grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(480px, 1fr)); gap: 1.5rem; margin-top: 2rem; }

      /* Card */
      .project_card { background: #fff; border: 1px solid #e8e8e4; border-radius: 16px; overflow: hidden; }

      /* Video area */
      .project_video_wrap { position: relative; width: 100%; aspect-ratio: 16/9; background: #1a1c1e; overflow: hidden; }
      .project_video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .project_video_overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.2s ease; }
      .project_video_overlay span { color: #fff; font-size: 0.85rem; font-weight: 500; background: rgba(0,82,255,0.8); padding: 0.5rem 1rem; border-radius: 100px; }

      /* Card body */
      .project_card_body { padding: 1rem; }
      .project_card_header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; }
      .project_card_title { font-size: 1.1rem; font-weight: 600; color: var(--text_color); }
      .project_card_links { display: flex; gap: 1rem; }
      .project_link { font-size: 0.8rem; font-weight: 500; color: #6b6b6b; text-decoration: none; transition: color 0.2s ease; }
      .project_card_desc { font-size: 0.88rem; color: #6b6b6b; line-height: 1.6; margin-bottom: 1rem; }

      /* ── Contact CTA ─────────────────────── */
      .contact_cta { padding: 5rem 0; background: var(--text_color); border-top: 1px solid #e8e8e4; }
      .contact_cta_inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.5rem; }
      .contact_cta .section_label { color: rgba(255,255,255,0.5); }
      .contact_cta .section_title { color: #fff; }
      .contact_cta .section_title em { color: var(--primary_color); }
      .contact_cta_sub { font-size: 0.95rem; color: rgba(255,255,255,0.5); }
      .contact_cta .btn_primary { background: #fff; color: var(--text_color); font-size: 1rem; padding: 0.9rem 2rem; }
      .contact_cta .btn_primary:hover { background: var(--primary_color); color: #fff; box-shadow: 0 4px 20px rgba(0,82,255,0.4); }
    </style>
  </head>

  <body>

    <%- include('partials/header') %>

    <!-- Scroll progress trail -->
    <div class="scroll_trail">
      <div class="scroll_trail_bar"></div>
      <div class="scroll_dots">
        <div class="scroll_dot active" data-section="hero">
          <span class="scroll_dot_label">Home</span>
        </div>
        <div class="scroll_dot" data-section="about">
          <span class="scroll_dot_label">About</span>
        </div>
        <div class="scroll_dot" data-section="experience">
          <span class="scroll_dot_label">Experience</span>
        </div>
        <div class="scroll_dot" data-section="projects">
          <span class="scroll_dot_label">Projects</span>
        </div>
      </div>
    </div>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero_inner">

          <!-- Left: text content -->
          <div class="hero_content">
            <span class="hero_tag">Available for work</span>
            <h1 class="hero_title">Hi, I'm <span class="hero_name">Albert</span> —<br/>Full Stack Developer</h1>
            <p class="hero_sub">
              I build clean, performant web applications from database to deployment.
              Focused on thoughtful code and great user experiences.
            </p>
            <div class="hero_actions">
              <a href="#about" class="btn btn_primary">Learn About Me</a>
              <a href="/contact" class="btn btn_ghost">Get in touch</a>
            </div>
          </div>

          <!-- Right: visual -->
          <div class="hero_visual">
            <div class="hero_blob"></div>
          </div>
        </div>
      </section>

    <!-- ABOUT -->
    <section class="about" id="about">
      <div class="about_inner">

        <div class="about_text">
          <span class="section_label">About me</span>
          <h2 class="section_title">Turning ideas into <em>reality</em></h2>

          <p class="about_body">
            Full stack engineer with 2+ years turning complex problems into
            clean, scalable solutions. 
          </p>

          <div class="about_grid">
            <ul class="about_list">
              <li>
                <span class="about_list_title">API Integrations</span>
                Connected third-party services into production systems
              </li>
              <li>
                <span class="about_list_title">File Storage</span>
                Configured profile image storage for thousands of users using Cloudflare Images API
              </li>
              <li>
                <span class="about_list_title">Performance</span>
                Optimised existing queries to deliver 10x faster load times
              </li>
              <li>
                <span class="about_list_title">Dashboards</span>
                Built interactive analytics with real-time data
              </li>
              <li>
                <span class="about_list_title">UI & UX</span>
                Improved interfaces that measurably lifted engagement & userflow
              </li>
            </ul>

            <!-- Right: stats -->
            <div class="about_stats ">
              <div class="stat">
                <span class="stat_num">2+</span>
                <span class="stat_label">Years experience</span>
              </div>
              <div class="stat">
                <span class="stat_num">25+</span>
                <span class="stat_label">Projects shipped</span>
              </div>
              <div class="stat">
                <span class="stat_num">∞</span>
                <span class="stat_label">Things to learn</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="experience">
      <div class="experience_inner">

        <!-- Header spans full width -->
        <div class="experience_header">
          <span class="section_label">Experience</span>
          <h2 class="section_title">Work history</h2>
        </div>

        <!-- Left: spine with dot + dashed trail -->
        <div class="timeline_spine">
          <span class="timeline_spine_label">Now</span>
          <div class="timeline_spine_dot"></div>
          <div class="timeline_spine_trail"></div>
          <span class="timeline_spine_label">2024</span>
          <div class="timeline_spine_dot"></div>
          <div class="timeline_spine_trail"></div>
          <span class="timeline_spine_label">2023</span>
        </div>

        <!-- Right: stacked cards -->
        <div class="timeline_cards">

          <div class="timeline_card ">
            <p class="timeline_card_date">2024 — Present</p>
            <h3 class="timeline_role">Full Stack Software Engineer</h3>
            <a class="timeline_company" href="https://info.microkeeper.com.au/" target="_blank">
              Microkeeper SAAS
              <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.75em;"></i>
            </a>
            <ul class="timeline_list">
              <li>Reckon and Xero Accounting Suite API Integrations</li>
              <li>Facilitated profile image uploads, updates, deletions, and storage for thousands of users using the Cloudflare Images API</li>
              <li>Optimised query performance resulting in <b>10x+ faster load times</b></li>
              <li>Built an independently configurable interactive analytics dashboard with real-time data visualisation</li>
              <li>Delivered UI & UX improvements across multiple modules, improving usability and user flow</li>
            </ul>
            <div class="timeline_tags">
              <span>PHP</span>
              <span>JavaScript</span>
              <span>MySQL</span>
            </div>
          </div>

          <div class="timeline_card ">
            <p class="timeline_card_date">2023 — 2024</p>
            <h3 class="timeline_role">Web Developer — Contract</h3>
            <a class="timeline_company" href="https://knightgroup.co.nz/" target="_blank">
              Knight Group Furniture
              <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.75em;"></i>
            </a>
            <ul class="timeline_list">
              <li>Worked on creating the frontend for an administration file storage system</li>
              <li>Built the registration system with Google Maps API integration for location-based business signups</li>
              <li>Frontend UI & UX improvements using React MUI library</li>
            </ul>
            <div class="timeline_tags">
              <span>C#</span>
              <span>Blazor .NET</span>
              <span>Tailwind</span>
              <span>JavaScript</span>
              <span>React MUI</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="projects fade_in" id="projects">
      <div class="projects_inner">

        <span class="section_label">Work</span>
        <h2 class="section_title">Featured projects</h2>

        <div class="projects_grid">

          <div class="project_card fade_in">
            <div class="project_video_wrap">
              <video src="../assets/videos/Dashboard_video_optimised.mp4" autoplay loop muted playsinline class="project_video"></video>
            </div>
            <div class="project_card_body">
              <div class="project_card_header">
                <h3 class="project_card_title">Analytics Dashboard</h3>

              </div>
              <p class="project_card_desc">
                Real-time analytics dashboard with interactive charts, 
                multi-source data integration and a fully responsive UI.
              </p>
              <div class="timeline_tags">
                <span>Query Optimisation</span>
                <span>Custom Configurations</span>
                <span>Chart JS Library</span>
              </div>
            </div>
          </div>

          <div class="project_card fade_in">
            <div class="project_video_wrap">
              <video src="../assets/videos/Skills_video_optimised.mp4" autoplay loop muted playsinline class="project_video"></video>
            </div>
            <div class="project_card_body">
              <div class="project_card_header">
                <h3 class="project_card_title">Skills HR Management Module</h3>
              </div>
              <p class="project_card_desc">
                HR can view and manage employee submitted skills and files, supports viewing and downloading of many file types.
              </p>
              <div class="timeline_tags">
                <span>Skills Workflow Overhaul</span>
                <span>UI and UX Improvements</span>
                <span>Mobile Responsive</span>
              </div>
            </div>
          </div>

          <div class="project_card fade_in">
            <div class="project_video_wrap">
              <video src="../assets/videos/Ecommerce_video_optimised.mp4" autoplay loop muted playsinline class="project_video"> </video>
            </div>
            <div class="project_card_body">
              <div class="project_card_header">
                <h3 class="project_card_title">Self Motivated Projects</h3>
              </div>
              <p class="project_card_desc">
                Clothing e-commerce site, features includes admin product edit page, shopping cart, registration, login, product search and filtering, and more to come.
              </p>
              <div class="timeline_tags">
                <span>BunJS</span>
                <span>TypeScript</span>
                <span>JavaScript</span>
                <span>MySQL</span>
                <span>In Progress</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="contact_cta fade_in">
      <div class="contact_cta_inner">
        <span class="section_label">Contact Me</span>
        <h2 class="section_title">Let's build something <em>together.</em></h2>
        <p class="contact_cta_sub">Available for full-time roles and freelance work. Based in Vic, Australia.</p>
        <a href="/contact" class="btn btn_primary">Get in touch →</a>
      </div>
    </section>
    
    </main>
    <script src="../js/script.js"></script>
  </body>
</html>